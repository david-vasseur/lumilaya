# ==== Phase 1 : Builder ====
FROM node:22-alpine AS builder

WORKDIR /app

# Copier uniquement package.json et package-lock.json pour le cache Docker
COPY package*.json ./

# Installer les dépendances
RUN npm ci

# Copier le code source et le schema Prisma
COPY . .
COPY prisma ./prisma

# Générer le client Prisma au build
RUN npx prisma generate

# Builder Next.js
RUN npm run build

# ==== Phase 2 : Image finale légère ====
FROM node:22-alpine

WORKDIR /app

# Définir l'environnement
ENV NODE_ENV=production

# Installer les dépendances système nécessaires pour Prisma
RUN apk add --no-cache bash openssl libc6-compat

# Copier node_modules et le code depuis le builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/ ./

# Exposer le port de l'app
EXPOSE 4004

# Commande pour lancer l'app
CMD ["npm", "start"]